# ============================================================================
# afk-cloud 环境变量模板 (复制为 .env 后填入真实值，切勿提交 .env 到 Git)
# 所有时间戳统一采用 UTC+8 (Asia/Shanghai)
# ============================================================================

# --- 1. 平台业务账号配置 (Chaoxing 学习通 / PTA) ---
CHAOXING_PHONE=
CHAOXING_PASSWORD=
CHAOXING_REALNAME=
CHAOXING_FID=2893
CHAOXING_AUTO_SUBMIT=false
# 可选：自定义位置签到坐标与地址 (未填则默认使用内置上海海洋大学教学楼/信息学院坐标池)
CHAOXING_SIGN_LON=
CHAOXING_SIGN_LAT=
CHAOXING_SIGN_ADDRESS=

PTA_SESSION_COOKIE=

# --- 2. 双轨认知模型分级配置 (Antigravity CLI & 备用 API) ---
# 默认优先使用本机已登录的 Antigravity CLI (agy) 免费/订阅配额
AFK_SOLVER_PROVIDER=agy
# 90% 常规客观题与批量 DOM 解析主力模型 (极速低延迟)
AFK_FLASH_MODEL=flash
# 10% 压轴编程题、主观论述与多轮报错自愈兜底模型
AFK_PRO_MODEL=pro

# 可选：若在无 agy 的纯容器内运行，可配置兼容 OpenAI/Gemini 的 API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# --- 3. Tier 0: Cloudflare 边缘与 D1 记忆库配置 (100% Free Tier) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 部署后的 Edge Worker URL (用于本地/Cloud Run 与 D1 同步题库缓存和待办任务)
AFK_EDGE_WORKER_URL=
AFK_EDGE_BEARER_TOKEN=

# --- 4. Tier 1 & Tier 2: Google Cloud 弹性算力配置 ---
# Tier 1: Cloud Run Jobs (每月 36万 vCPU-秒 + 18万 GiB-秒 永久免费)
GCP_PROJECT_ID=
GCP_REGION=asia-east1
GCP_ZONE=asia-east1-b
GCP_SERVICE_ACCOUNT=sa-antigravity-worker
CLOUD_RUN_JOB_NAME=afk-sandbox-runner

# Tier 2: 高负载 gcloud 短时拉起 GCE 配置 (带物理 TTL 自毁熔断)
GCE_BURST_MACHINE_TYPE=e2-micro
GCE_BURST_TTL_MINUTES=15
GCE_BURST_USE_SPOT=true

# --- 5. 消息通知推送 (支持事件即时通知 + 每日 08:30/21:00 定期汇总简报) ---
# 支持：飞书/钉钉/企业微信 Webhook、Server酱(微信)、PushPlus(微信)、Bark(iOS)、Telegram Bot
WEBHOOK_URL=
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
BARK_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
