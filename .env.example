# ============================================================================
# afk-cloud 环境变量模板 (复制为 .env 后填入真实值，切勿提交 .env 到 Git)
# 所有时间戳统一采用 UTC+8 (Asia/Shanghai)
# ============================================================================

# --- 1. 平台业务账号配置 (Chaoxing 学习通 / PTA) ---
CHAOXING_PHONE=
CHAOXING_PASSWORD=
CHAOXING_REALNAME=
CHAOXING_FID=2893
CHAOXING_AUTO_SUBMIT=false
# 可选：自定义位置签到坐标与地址 (未填则默认使用内置上海海洋大学教学楼/信息学院坐标池)
CHAOXING_SIGN_LON=
CHAOXING_SIGN_LAT=
CHAOXING_SIGN_ADDRESS=

PTA_SESSION_COOKIE=

# --- 2. 双轨认知模型分级配置 (Antigravity CLI & 备用 API) ---
# 默认优先使用本机已登录的 Antigravity CLI (agy) 免费/订阅配额
AFK_SOLVER_PROVIDER=agy
# 90% 常规客观题与批量 DOM 解析主力模型 (默认切到 Gemini 4 Hydrogen Medium，极速低延迟)
AFK_FLASH_MODEL=gemini-4-hydrogen-medium
# 10% 压轴编程题、1M 超大长上下文课件 RAG、主观论述与多轮报错自愈兜底模型
AFK_PRO_MODEL=gemini-4-hydrogen-xhigh

# 可选：若在无 agy 的纯容器内运行，可配置兼容 OpenAI/Gemini 的 API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1

# --- 3. Tier 0: Cloudflare 边缘与 D1 记忆库配置 (100% Free Tier) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 部署后的 Edge Worker URL (用于本地/Cloud Run 与 D1 同步题库缓存和待办任务)
AFK_EDGE_WORKER_URL=
# 边缘节点 API 鉴权 Token (自动生成或自定，禁止公网裸奔)
AFK_EDGE_BEARER_TOKEN=
# 可选：Web 看板独立访问口令 (未填则复用 AFK_EDGE_BEARER_TOKEN)
DASHBOARD_PASSWORD=

# --- 4. Tier 1 & Tier 2: Google Cloud 弹性算力与常驻节点通信安全 ---
# Edge <-> GCP 常驻节点 (Shim) HMAC-SHA256 共享通信签名密钥 (至少 32 字符，可用 openssl rand -hex 32 生成)
AFK_SHIM_SECRET=
# 允许派发的任务目标域名白名单 (逗号分隔)
AFK_TASK_HOST_ALLOWLIST=chaoxing.com,zhihuishu.com,pintia.cn
# Tier 1: Cloud Run Jobs (每月 36万 vCPU-秒 + 18万 GiB-秒 永久免费)
GCP_PROJECT_ID=
GCP_REGION=us-west1
GCP_ZONE=us-west1-a
GCP_SERVICE_ACCOUNT=sa-antigravity-worker
CLOUD_RUN_JOB_NAME=afk-sandbox-runner

# Tier 2: 高负载 gcloud 短时拉起 GCE 配置 (带物理 TTL 自毁熔断)
GCE_BURST_MACHINE_TYPE=e2-micro
GCE_BURST_TTL_MINUTES=15
GCE_BURST_USE_SPOT=true

# --- 5. 消息通知推送 (【100% 可选 / 非必需】，不配置请直接留空，不影响系统正常运行) ---
# 系统所有 24/7 签到流水与作业状态均实时落盘在 Cloudflare D1 并在 Web 看板展示。
# 仅当您希望在手机通知栏接收即时弹窗（如“签到成功”、“作业草稿已生成待审核”）时，才按需填入任一通道：
# - Bark (iOS App): 填入从 Bark 客户端复制的 Device Key (如: https://api.day.app/your_key/ 或 key)
# - Server酱 / PushPlus: 微信模板消息推送 Key / Token
# - 企业微信 / 钉钉 / 飞书: 群机器人 Webhook 完整 URL
WEBHOOK_URL=
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
BARK_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
