{
  "manifest_version": 3,
  "name": "afk-cloud PTA 会话伴侣",
  "version": "0.0.1",
  "description": "在 pintia.cn 登录时自动勾选「记住我」并静默将完整 Cookie（含 HttpOnly PTASession）与续期状态同步到个人 afk-cloud Edge D1（绝不自动破解验证码）。",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://pintia.cn/*",
    "https://passport.pintia.cn/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pintia.cn/*",
        "https://passport.pintia.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "afk-cloud PTA 会话同步"
  }
}
