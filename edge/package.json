{
  "name": "@afk-cloud/edge",
  "version": "1.0.0",
  "private": true,
  "description": "Tier 0 Cloudflare Workers + D1 Edge Heartbeat, Sign-in & Persistent Memory Layer",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "migrate:local": "wrangler d1 execute afk-cloud-db --local --file=./migrations/0001_init.sql",
    "migrate:remote": "wrangler d1 execute afk-cloud-db --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.86.0"
  }
}
