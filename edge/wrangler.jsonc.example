{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaoxing-dashboard-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "CHAOXING_REALNAME": "同学",
    "AUTO_SUBMIT_HOMEWORK": "false",
    "HOMEWORK_SCAN_INTERVAL_MINUTES": "10"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afk-cloud-db",
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CHAOXING_KV",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ]
}
